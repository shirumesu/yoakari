{
  "name": "astro-yoakari",
  "version": "0.1.0",
  "description": "A soft, sakura-toned blog theme for Astro, shipped as an integration.",
  "license": "MIT",
  "author": "shirumesu",
  "homepage": "https://github.com/shirumesu/yoakari#readme",
  "repository": {
    "type": "git",
