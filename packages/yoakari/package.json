    "astro-expressive-code": "^0.44.4",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "pagefind": "^1.6.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
