---
import { pageUrl } from '../utils/posts.ts';
interface Props { current: number; total: number }
const { current, total } = Astro.props;
---
{total > 1 && (
  <nav class="pager" aria-label="分页">
    {current > 1 && <a href={pageUrl(current - 1)} aria-label="上一页">‹</a>}
    {Array.from({ length: total }, (_, i) => i + 1).map((n) => (
      <a href={pageUrl(n)} class:list={{ on: n === current }} aria-current={n === current ? 'page' : undefined}>{n}</a>
    ))}
    {current < total && <a href={pageUrl(current + 1)} aria-label="下一页">›</a>}
  </nav>
)}
